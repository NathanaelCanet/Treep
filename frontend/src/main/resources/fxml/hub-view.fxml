<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.treep.frontend.controller.HubController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="80.0" spacing="20.0" style="-fx-background-color: #2c3e50;">
            <children>
                <Label text="TREEP HUB" textFill="WHITE">
                    <font>
                        <Font name="Segoe UI Bold" size="28.0" />
                    </font>
                </Label>
                <Button mnemonicParsing="false" onAction="#onRefresh" styleClass="button, btn-secondary" text="Rafraîchir" />
                <Button mnemonicParsing="false" onAction="#onOpenCreate" styleClass="button, btn-success" text="+ Créer Voyage" />
            </children>
            <padding>
                <Insets left="30.0" right="30.0" />
            </padding>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: #ecf0f1; -fx-border-color: transparent;">
            <content>
                <VBox fx:id="mainContainer" alignment="TOP_CENTER" spacing="15.0">
                    <padding>
                        <Insets bottom="30.0" left="100.0" right="100.0" top="30.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>