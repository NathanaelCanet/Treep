<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.treep.frontend.controller.DashboardController">


    <center>
        <VBox spacing="20" alignment="CENTER_LEFT" styleClass="form-container">
            <padding><Insets top="40" right="60" bottom="40" left="60"/></padding>

            <Label text="Ajouter un voyage" styleClass="title-label"/>

            <VBox spacing="5">
                <Label text="Destination" styleClass="label-white"/>
                <TextField fx:id="destInput" promptText="Ex: Tokyo, Japon"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Budget Total (€)" styleClass="label-white"/>
                <TextField fx:id="priceInput" promptText="Ex: 2500.00"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Date de départ" styleClass="label-white"/>
                <DatePicker fx:id="dateInput" promptText="Sélectionner une date" maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Activités (Optionnel)" styleClass="label-white"/>
                <TextField fx:id="activitiesInput" promptText="Ex: Musée, Ski, Plage..."/>
                <Label text="* Séparez par des virgules" style="-fx-font-size: 11px; -fx-text-fill: #bdc3c7;"/>
            </VBox>

            <VBox VBox.vgrow="ALWAYS" />

            <Button text="ENREGISTRER LE VOYAGE" onAction="#onSubmit"
                    styleClass="button, btn-success"
                    maxWidth="Infinity" prefHeight="45"/>
        </VBox>
    </center>

</BorderPane>